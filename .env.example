# Copy this file to .env and fill in real values before running
# `docker compose up -d`.

# Contact email sent as part of the User-Agent header on upstream registry
# requests (Brønnøysundregistrene etc. ask for this as a courtesy so they
# can reach you if a client misbehaves).
REGISTRY_MCP_CONTACT_EMAIL=you@example.com

# Shared secret required to call admin-only endpoints. Generate one with:
#   openssl rand -hex 32
REGISTRY_MCP_ADMIN_KEY=change-me

# Public domain name this instance is served from. Caddy uses this to
# request and renew a TLS certificate automatically.
REGISTRY_MCP_DOMAIN=example.com

# Path to the SQLite cache file inside the container. Must live under
# /app/data so it persists on the `registry-data` Docker volume.
REGISTRY_MCP_CACHE_PATH=/app/data/cache.sqlite3
