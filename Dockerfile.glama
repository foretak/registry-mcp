# Dockerfile for the Glama.ai listing check (https://glama.ai/mcp/servers).
#
# Glama builds this image and speaks MCP to the container over **stdio**
# (initialize → tools/list), so the CMD must be the stdio entrypoint, not the
# HTTP API. The main `Dockerfile` starts uvicorn for Railway/compose and would
# fail Glama's introspection. Paste this file into the Dockerfile field of the
# Glama server settings; it is not used by any other deployment.
#
# Local check (same three JSON-RPC lines Glama's inspector sends):
#   docker build -f Dockerfile.glama -t registry-mcp-glama .
#   docker run --rm -i registry-mcp-glama < tests/fixtures/tools_list.jsonl

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-install-project --no-dev

COPY src ./src
RUN uv sync --locked --no-dev

RUN groupadd --system app && useradd --system --gid app --create-home app \
    && mkdir -p /app/data && chown -R app:app /app/data

ENV PATH="/app/.venv/bin:$PATH" \
    REGISTRY_MCP_CACHE_PATH=/app/data/cache.sqlite3

USER app

# stdio MCP server: `registry-mcp` is the [project.scripts] entry
# (registry_mcp.mcp.server:main). Optional: COMPANIES_HOUSE_API_KEY for GB.
CMD ["registry-mcp"]
